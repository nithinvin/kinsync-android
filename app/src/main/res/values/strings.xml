<resources>
    <string name="app_name">KinSync</string>

    <string name="consent_title">Before we start</string>
    <string name="consent_title_updated">KinSync has changed</string>
    <string name="consent_updated_intro">KinSync now notices a few more things. Please read
        what it does and agree again to keep it running.</string>
    <string name="consent_intro">KinSync quietly checks that your day looks normal for you. To
        do that, it notices:</string>
    <string name="consent_signal_unlocks">When you unlock your phone and when the screen turns
        on or off</string>
    <string name="consent_signal_app_usage">Which apps you use and for how long</string>
    <string name="consent_signal_last_moved">When your phone last moved (no step counting, no
        location)</string>
    <string name="consent_signal_activity">Whether you are still, walking or in a
        vehicle</string>
    <string name="consent_privacy">All of this stays on this phone, and you can see it in the
        app. KinSync never reads what you type, never listens, and never tracks where you go.
        Only a simple \"I\'m okay\" signal will ever be sent to your family. You can turn this
        off at any time.</string>
    <string name="consent_agree">I agree, continue</string>
    <string name="consent_decline">No, don\'t monitor me</string>
    <string name="consent_declined_message">KinSync is off. Nothing is being collected. You can
        agree above whenever you are ready.</string>

    <string name="usage_access_title">Allow activity check</string>
    <string name="usage_access_body">Android requires a special permission called \"Usage
        access\" before an app can help notice your daily patterns. KinSync only uses this to
        recognize when your phone is being used — it does not read any content.</string>
    <string name="usage_access_open_settings">Open settings</string>
    <string name="usage_access_continue">I\'ve granted access, continue</string>

    <string name="activity_permission_title">Notice walking and resting</string>
    <string name="activity_permission_body">KinSync can notice whether you are still, walking or
        travelling in a vehicle. Android calls this \"Physical activity\" and asks you to allow
        it. Only the kind of activity and the time are kept, on this phone. KinSync never records
        where you go.</string>
    <string name="activity_permission_allow">Allow</string>
    <string name="activity_permission_not_now">Not now</string>
    <string name="activity_permission_granted">Allowed. Thank you.</string>
    <string name="activity_permission_denied">Not allowed. If you change your mind, open
        KinSync\'s settings and allow \"Physical activity\".</string>
    <string name="activity_permission_open_settings">Open settings</string>
    <string name="activity_permission_continue">Continue</string>

    <string name="battery_title">Keep monitoring reliable</string>
    <string name="battery_body">To make sure KinSync can\'t be silently stopped by battery
        optimization, please allow it to run in the background. This does not mean the app runs
        wastefully — it only wakes briefly when your screen turns on or off.</string>
    <string name="battery_open_settings">Allow background activity</string>
    <string name="battery_continue">Continue</string>

